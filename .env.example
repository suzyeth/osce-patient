# OSCE_DAILY_BUDGET_USD=0.5
# OSCE_TIMEOUT_MS=30000
# OSCE_MAX_RETRIES=2
# OSCE_JUDGE_MAX_TOKENS=800
# OSCE_PATIENT_MAX_TOKENS=400
# OSCE_BUDGET_FILE=.osce-budget.json
